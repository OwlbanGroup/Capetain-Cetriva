[MASTER]
# The 'plaid' package is an optional integration dependency and may not be
# installed locally; don't flag its imports as errors (E0401).
ignored-modules=plaid,scripts,hooks

[MESSAGES CONTROL]
# Test files access _private methods for unit testing private helpers
ignore-paths=test_
# Broad exception catches are used deliberately at integration boundaries
# (API gateways, NVML) where any failure must be converted into a logged,
# structured error response. Each site carries an inline disable comment.

[BASIC]
# Test methods (test_*) and standard unittest fixtures do not require
# docstrings; module and class docstrings are still enforced.
no-docstring-rgx=^(?:test_|setUp|tearDown|setUpClass|tearDownClass|_)
