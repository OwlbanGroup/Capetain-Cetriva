[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    node_modules,
    build,
    dist,
    htmlcov,
    .tox,
    .eggs,
    *.egg-info
extend-ignore =
    W293,
    E203,
    E501,
per-file-ignores =
    # Tests can use protected members
    test_*.py: protected-access
    # Mock assignments don't need type annotations
    conftest.py: E501
