#!/usr/bin/env bash
# Pre-commit hook: run linters and TESTING-mode tests
set -euo pipefail

echo "Pre-commit checks..."

# isort
python -m isort --check-only . || exit 1

# flake8
python -m flake8 || exit 1

# Fast tests
TESTING=1 PYTHONWARNINGS=ignore ACH_API_KEY=test-ci-key `
    python -m pytest -q --no-header --no-cov || exit 1

echo "All pre-commit checks passed."
